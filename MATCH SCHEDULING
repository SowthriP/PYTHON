n=int(input("Enter the teams :"))
teams=[]
for i in range(n):
    t=input("Enter the team name :")
    teams.append(t)
matches=[]
for i in range(n-1):
    for j in range(i+1,n):
        matches.append([teams[i],teams[j]])
pos=1
for i in matches:
    print("MATCH{} : {} vs {} ".format(pos,i[1],i[0]))
    pos=pos+1
