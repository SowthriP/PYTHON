password=input("ENTER YOUR PASSWORD : ")
up=0
sm=0
dg=0
sp=0
if len(password)>7:
    for i in password:
        if i.isupper():
            up+=1
        elif i.islower():
            sm+=1
        elif i.isdigit():
            dg+=1
        else:
            sp+=1
    if up>0 and sm>0 and dg>0 and sp>0:
        print("YOUR PASSWORD IS STRONG")
    else:
        print("YOUR PASSWORD IS WEAK")
else:
    print("TOO WEAK DUE TO LESS CHARACTERS")
