a=[[61,62,63,64,65,66],
   [11,12,13,14,15,16],
   [21,22,23,24,25,26],
   [31,32,33,34,35,36],
   [41,42,43,44,45,46],
   [51,52,53,54,55,56]]
top=0
bottom=(len(a))-1
left=0
right=len(a[0])-1
while (left<right and top<=bottom ):
    
    for i in range(left,right+1):
        print(a[top][i],end=" ")
    
    top+=1
    
    for i in range(top,bottom+1):
        print(a[i][right],end=" ")
    
    right-=1
    
    if top<right:
        for i in range(left,right-1,-1):
            print(a[i][bottom],end=" ")
    bottom-=1
    
    if left<right:
        for i in range(bottom,top-1,-1):
            print(a[left][i],end=" ")
    left+=1        
    
    
